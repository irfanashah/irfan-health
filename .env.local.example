NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email alerts (Resend) ──────────────────────────────────────────────
# Optional but recommended. Missing key → cron emails are no-ops
# (warn-only); the cron itself still completes. ALERT_EMAIL_FROM
# defaults to Resend's verified test sender (onboarding@resend.dev)
# which delivers to the account owner's own email — zero DNS setup.
# Verify a domain in Resend to set a custom From line later.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
